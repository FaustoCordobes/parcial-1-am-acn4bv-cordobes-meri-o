<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BaristaApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorOnPrimary">@color/secondary_color</item>
        <item name="colorPrimaryContainer">@color/secondary_color</item>
        <item name="colorOnPrimaryContainer">@color/primary_color</item>

        <item name="colorSecondary">@color/accent_caramel</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_caramel_light</item>
        <item name="colorOnSecondaryContainer">@color/primary_color</item>

        <item name="colorTertiary">@color/success</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/primary_color</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/primary_color</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorSurfaceContainer">@color/surface_light</item>
        <item name="colorSurfaceContainerLow">@color/background_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_light</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/Shape.Barista.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Barista.Medium</item>

        <item name="materialButtonStyle">@style/Widget.Barista.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Barista.Card</item>
        <item name="textInputStyle">@style/Widget.Barista.TextInput</item>
    </style>

    <style name="Theme.BaristaApp" parent="Base.Theme.BaristaApp" />

    <style name="Shape.Barista.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Barista.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Barista.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.Barista.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/primary_color</item>
        <item name="android:textColor">@color/primary_color</item>
    </style>

    <style name="Widget.Barista.Button.Accent" parent="Widget.Barista.Button">
        <item name="backgroundTint">@color/accent_caramel</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Barista.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="strokeColor">@color/outline_light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="Widget.Barista.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_caramel</item>
        <item name="hintTextColor">@color/accent_caramel_dark</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <style name="Text.Barista.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Barista.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>