<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BaristaApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ds_accent_light</item>
        <item name="colorOnPrimary">@color/ds_on_accent_light</item>
        <item name="colorPrimaryContainer">@color/ds_accent_soft_light</item>
        <item name="colorOnPrimaryContainer">@color/ds_accent_light</item>

        <item name="colorSecondary">@color/ds_accent_light</item>
        <item name="colorOnSecondary">@color/ds_on_accent_light</item>
        <item name="colorSecondaryContainer">@color/ds_accent_soft_light</item>
        <item name="colorOnSecondaryContainer">@color/ds_ink_light</item>

        <item name="colorTertiary">@color/success</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="android:colorBackground">@color/ds_background_light</item>
        <item name="colorOnBackground">@color/ds_ink_light</item>
        <item name="colorSurface">@color/ds_surface_light</item>
        <item name="colorOnSurface">@color/ds_ink_light</item>
        <item name="colorSurfaceVariant">@color/ds_background_light</item>
        <item name="colorOnSurfaceVariant">@color/ds_ink_secondary_light</item>
        <item name="colorSurfaceContainer">@color/ds_surface_light</item>
        <item name="colorSurfaceContainerLow">@color/ds_background_light</item>
        <item name="colorSurfaceContainerHigh">@color/ds_surface_light</item>
        <item name="colorOutline">@color/ds_line_light</item>
        <item name="colorOutlineVariant">@color/ds_line_light</item>

        <item name="colorError">@color/ds_error_light</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:statusBarColor">@color/ds_header_light</item>
        <item name="android:navigationBarColor">@color/ds_background_light</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="shapeAppearanceSmallComponent">@style/Shape.Barista.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Barista.Medium</item>

        <item name="materialButtonStyle">@style/Widget.Barista.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Barista.Card</item>
        <item name="textInputStyle">@style/Widget.Barista.TextInput</item>
    </style>

    <style name="Theme.BaristaApp" parent="Base.Theme.BaristaApp" />

    <style name="Shape.Barista.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Shape.Barista.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.Barista.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="Widget.Barista.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Barista.Button.Accent" parent="Widget.Barista.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.Barista.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="Widget.Barista.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.Barista.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimary</item>
    </style>

    <style name="Text.Barista.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Barista.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Barista.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Barista.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Barista.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Shape.Barista.Thumb" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Text.Barista.Row" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Barista.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Barista.Stat" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Barista.Button.Danger" parent="Widget.Barista.Button.Outlined">
        <item name="strokeColor">?attr/colorError</item>
        <item name="android:textColor">?attr/colorError</item>
    </style>
    <style name="Text.Barista.OnPhoto" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Text.Barista.OnPhotoCaption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:alpha">0.8</item>
    </style>
    <style name="Text.Barista.PillOnPhoto" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:textColor">@color/ds_header_light</item>
    </style>

    <style name="Text.Barista.Link" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="Text.Barista.Hero" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/ds_ink_dark</item>
    </style>

    <style name="Text.Barista.Timer" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="fontFamily">@font/bricolage_grotesque_bold</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Barista.Field" parent="">
    <item name="android:background">@drawable/bg_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Barista.Choice" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:textColor">@color/choice_text</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/choice_height</item>
        <item name="android:minWidth">0dp</item>
    </style>

</resources>
