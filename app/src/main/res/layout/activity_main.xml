<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/spacing_screen"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_select_machine"
        android:textSize="@dimen/text_size_title"
        android:textColor="@color/coffee_brown"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/spacing_card"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/frenchPressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card_background"
            android:padding="@dimen/spacing_card"
            android:layout_marginBottom="@dimen/spacing_card">

            <ImageView
                android:id="@+id/frenchPressImage"
                android:layout_width="@dimen/card_image_size"
                android:layout_height="@dimen/card_image_size"
                android:src="@drawable/prensa_francesa" />

            <TextView
                android:id="@+id/frenchPressLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/coffee_french_press"
                android:textSize="@dimen/text_size_label" />

            <Button
                android:id="@+id/frenchPressButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_select" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mokaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card_background"
            android:padding="@dimen/spacing_card"
            android:layout_marginBottom="@dimen/spacing_card">

            <ImageView
                android:id="@+id/mokaImage"
                android:layout_width="@dimen/card_image_size"
                android:layout_height="@dimen/card_image_size"
                android:src="@drawable/moka_italiana" />

            <TextView
                android:id="@+id/mokaLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/coffee_moka"
                android:textSize="@dimen/text_size_label" />

            <Button
                android:id="@+id/mokaButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_select" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dripCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card_background"
            android:padding="@dimen/spacing_card">

            <ImageView
                android:id="@+id/dripImage"
                android:layout_width="@dimen/card_image_size"
                android:layout_height="@dimen/card_image_size"
                android:src="@drawable/cafetera_de_goteo" />

            <TextView
                android:id="@+id/dripLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/coffee_drip"
                android:textSize="@dimen/text_size_label" />

            <Button
                android:id="@+id/dripButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_select" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/step2Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="@dimen/spacing_card"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/step2TitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/coffee_brown"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_card" />

        <EditText
            android:id="@+id/coffeeAmountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/hint_coffee_amount"
            android:layout_marginBottom="@dimen/spacing_card" />

        <TextView
            android:id="@+id/intensityLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step2_intensity_label"
            android:textSize="@dimen/text_size_label"
            android:layout_marginBottom="@dimen/spacing_card" />

        <RadioGroup
            android:id="@+id/intensityRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_card">

            <RadioButton
                android:id="@+id/intensitySoftRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/intensity_soft" />

            <RadioButton
                android:id="@+id/intensityMediumRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/intensity_medium" />

            <RadioButton
                android:id="@+id/intensityStrongRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/intensity_strong" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/step2BackButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_back" />

            <Button
                android:id="@+id/step2ContinueButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/btn_continue" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/step3Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="@dimen/spacing_card"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/step3TitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step3_title"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/coffee_brown"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_card" />

        <RadioGroup
            android:id="@+id/grindStatusRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/spacing_card">

            <RadioButton
                android:id="@+id/groundRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/grind_status_ground" />

            <RadioButton
                android:id="@+id/wholeBeanRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/grind_status_whole_bean" />

        </RadioGroup>

        <TextView
            android:id="@+id/grindTypeResultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/card_background"
            android:padding="@dimen/spacing_card"
            android:textSize="@dimen/text_size_label"
            android:layout_marginBottom="@dimen/spacing_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/step3BackButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_back" />

            <Button
                android:id="@+id/step3ContinueButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/btn_continue" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/step4Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="@dimen/spacing_card"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/step4TitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step4_title"
            android:textSize="@dimen/text_size_label"
            android:textColor="@color/coffee_brown"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_card" />

        <TextView
            android:id="@+id/waterAmountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label" />

        <TextView
            android:id="@+id/coffeeAmountResultTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label" />

        <TextView
            android:id="@+id/estimatedTimeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_label"
            android:layout_marginBottom="@dimen/spacing_card" />

        <TextView
            android:id="@+id/tipTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_background"
            android:padding="@dimen/spacing_card"
            android:textSize="@dimen/text_size_label"
            android:layout_marginBottom="@dimen/spacing_card" />

        <TextView
            android:id="@+id/stopwatchLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stopwatch_label"
            android:textSize="@dimen/text_size_label"
            android:layout_marginBottom="@dimen/spacing_card" />

        <TextView
            android:id="@+id/stopwatchDisplayTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/coffee_brown"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_card">

            <Button
                android:id="@+id/stopwatchStartButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/stopwatchResetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_card"
                android:text="@string/btn_reset" />

        </LinearLayout>

        <Button
            android:id="@+id/addToIdealButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_to_ideal"
            android:layout_marginBottom="@dimen/spacing_card" />

        <Button
            android:id="@+id/step4BackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_back" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>