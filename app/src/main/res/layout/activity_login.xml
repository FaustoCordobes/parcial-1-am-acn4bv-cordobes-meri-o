<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".LoginActivity">

    <LinearLayout
        android:id="@+id/login_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/login_spacing"
        android:layout_marginEnd="@dimen/login_spacing"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/login_logo"
            android:layout_width="@dimen/login_logo_size"
            android:layout_height="@dimen/login_logo_size"
            android:contentDescription="@string/login_logo_description"
            android:src="@drawable/ic_coffee_generic" />

        <TextView
            android:id="@+id/login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_screen"
            android:text="@string/login_title"
            android:textColor="@color/primary_color"
            android:textSize="@dimen/text_size_login_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_card"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_secondary_light"
            android:textSize="@dimen/text_size_label" />

        <EditText
            android:id="@+id/login_username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:autofillHints="username"
            android:hint="@string/login_username_hint"
            android:inputType="text"
            android:visibility="gone"
            android:textColor="@color/primary_color"
            android:textColorHint="@color/text_secondary_light" />

        <EditText
            android:id="@+id/login_email_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:autofillHints="emailAddress"
            android:hint="@string/login_email_hint"
            android:inputType="textEmailAddress"
            android:textColor="@color/primary_color"
            android:textColorHint="@color/text_secondary_light" />

        <EditText
            android:id="@+id/login_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:autofillHints="password"
            android:hint="@string/login_password_hint"
            android:inputType="textPassword"
            android:textColor="@color/primary_color"
            android:textColorHint="@color/text_secondary_light" />

        <EditText
            android:id="@+id/login_password_confirm_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:hint="@string/login_password_confirm_hint"
            android:visibility="gone"
            android:textColor="@color/primary_color"
            android:textColorHint="@color/text_secondary_light"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:backgroundTint="@color/accent_caramel"
            android:text="@string/login_button"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/login_register_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:backgroundTint="@color/primary_color"
            android:text="@string/login_register_button"
            android:textColor="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>