<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".LoginActivity">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/login_hero_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />
    <ImageView
        android:id="@+id/login_hero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/login_hero_guide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/login_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_padding"
        android:layout_marginTop="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/login_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/login_logo_description"
            android:src="@drawable/ic_logo_bean"
            android:tint="@color/ds_header_highlight" />

        <TextView
            android:id="@+id/login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_gap"
            android:text="@string/header_logo_text"
            style="@style/Text.Barista.Title"
            android:textColor="@color/ds_ink_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/login_hero_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_padding"
        android:layout_marginEnd="@dimen/header_padding"
        android:layout_marginBottom="48dp"
        android:text="@string/login_hero_title"
        style="@style/Text.Barista.Hero"
        app:layout_constraintBottom_toBottomOf="@+id/login_hero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/sheet_overlap"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_hero">

        <LinearLayout
            android:id="@+id/login_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical"
            android:paddingStart="@dimen/login_spacing"
            android:paddingTop="@dimen/login_spacing"
            android:paddingEnd="@dimen/login_spacing"
            android:paddingBottom="@dimen/login_spacing">

            <TextView
                android:id="@+id/login_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_screen"
                android:text="@string/login_subtitle"
                style="@style/Text.Barista.Subtitle" />

            <EditText
                android:id="@+id/login_username_input"
                style="@style/Widget.Barista.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:drawableStart="@drawable/ic_nav_me"
                android:drawablePadding="@dimen/login_field_icon_padding"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:hint="@string/login_username_hint"
                android:inputType="text"
                android:visibility="gone" />

            <EditText
                android:id="@+id/login_email_input"
                style="@style/Widget.Barista.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_field_mail"
                android:drawablePadding="@dimen/login_field_icon_padding"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:hint="@string/login_email_hint"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/login_password_input"
                style="@style/Widget.Barista.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:autofillHints="password"
                android:drawableStart="@drawable/ic_field_lock"
                android:drawablePadding="@dimen/login_field_icon_padding"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/login_password_confirm_input"
                style="@style/Widget.Barista.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:drawableStart="@drawable/ic_field_lock"
                android:drawablePadding="@dimen/login_field_icon_padding"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:hint="@string/login_password_confirm_hint"
                android:inputType="textPassword"
                android:visibility="gone" />

            <Button
                android:id="@+id/login_button"
                style="@style/Widget.Barista.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_spacing"
                android:text="@string/login_button" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:layout_marginBottom="@dimen/spacing_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_card"
                    android:layout_marginEnd="@dimen/spacing_card"
                    android:text="@string/login_or"
                    style="@style/Text.Barista.Subtitle" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutline" />
            </LinearLayout>

            <Button
                android:id="@+id/login_register_button"
                style="@style/Widget.Barista.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_register_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_spacing"
                android:gravity="center"
                android:text="@string/login_footer"
                style="@style/Text.Barista.Subtitle" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
