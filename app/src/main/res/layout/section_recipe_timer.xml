<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_label_4"
        style="@style/Text.Barista.Label" />

    <TextView
        android:id="@+id/step4TitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_screen"
        android:text="@string/step4_title"
        style="@style/Text.Barista.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_field"
        android:orientation="vertical"
        android:padding="@dimen/spacing_screen">

        <TextView
            android:id="@+id/waterAmountTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Text.Barista.Row" />

        <TextView
            android:id="@+id/coffeeAmountResultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_card"
            style="@style/Text.Barista.Row" />

        <TextView
            android:id="@+id/estimatedTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_card"
            style="@style/Text.Barista.Row" />
    </LinearLayout>

    <TextView
        android:id="@+id/tipTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_card"
        android:background="@drawable/bg_tip"
        android:padding="@dimen/spacing_screen"
        style="@style/Text.Barista.Subtitle"
        android:textColor="?attr/colorOnSecondaryContainer" />

    <TextView
        android:id="@+id/stopwatchLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/login_spacing"
        android:text="@string/stopwatch_label"
        style="@style/Text.Barista.Label" />

    <TextView
        android:id="@+id/stopwatchDisplayTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_card"
        android:gravity="center"
        android:text="@string/_00_00"
        style="@style/Text.Barista.Timer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_card"
        android:orientation="horizontal">

        <Button
            android:id="@+id/stopwatchStartButton"
            style="@style/Widget.Barista.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_start" />

        <Button
            android:id="@+id/stopwatchResetButton"
            style="@style/Widget.Barista.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_card"
            android:layout_weight="1"
            android:text="@string/btn_reset" />
    </LinearLayout>

    <Button
        android:id="@+id/recipePickPhotoButton"
        style="@style/Widget.Barista.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_card"
        android:text="@string/recipe_pick_photo" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/recipePhotoPreview"
        android:layout_width="@dimen/recipe_photo_preview_size"
        android:layout_height="@dimen/recipe_photo_preview_size"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/spacing_card"
        android:contentDescription="@string/recipe_photo_preview_description"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/Shape.Barista.Thumb" />

    <Button
        android:id="@+id/addToIdealButton"
        style="@style/Widget.Barista.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_card"
        android:text="@string/btn_add_to_ideal" />

    <Button
        android:id="@+id/step4BackButton"
        style="@style/Widget.Barista.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_back" />
</LinearLayout>
