<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".MethodDetailActivity">

    <ScrollView
        android:id="@+id/methodDetailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/methodDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_screen">

            <ImageView
                android:id="@+id/methodDetailImage"
                android:layout_width="@dimen/method_detail_image_size"
                android:layout_height="@dimen/method_detail_image_size"
                android:background="@color/card_background"
                android:contentDescription="@string/method_detail_image_description"
                android:padding="@dimen/spacing_card"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/methodDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_screen"
                android:textColor="@color/secondary_color"
                android:textSize="@dimen/text_size_detail_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/methodDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:gravity="center"
                android:textColor="@color/text_secondary_dark"
                android:textSize="@dimen/text_size_label" />

            <LinearLayout
                android:id="@+id/methodDetailInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_screen"
                android:background="@color/card_background"
                android:orientation="vertical"
                android:padding="@dimen/spacing_screen">

                <TextView
                    android:id="@+id/methodDetailRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/coffee_brown"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/methodDetailGrind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card"
                    android:textColor="@color/coffee_brown"
                    android:textSize="@dimen/text_size_label" />

                <TextView
                    android:id="@+id/methodDetailTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_card"
                    android:textColor="@color/coffee_brown"
                    android:textSize="@dimen/text_size_label" />
            </LinearLayout>

            <Button
                android:id="@+id/methodDetailBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_screen"
                android:text="@string/method_detail_back" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
