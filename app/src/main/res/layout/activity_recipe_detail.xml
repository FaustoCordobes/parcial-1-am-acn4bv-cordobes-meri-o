<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".RecipeDetailActivity">

    <LinearLayout
        android:id="@+id/recipeDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_header_light"
        android:orientation="vertical"
        android:paddingStart="@dimen/header_padding"
        android:paddingTop="@dimen/spacing_screen"
        android:paddingEnd="@dimen/header_padding"
        android:paddingBottom="@dimen/header_padding_bottom">

        <ImageButton
            android:id="@+id/recipeDetailBackButton"
            android:layout_width="@dimen/profile_icon_button_size"
            android:layout_height="@dimen/profile_icon_button_size"
            android:background="@drawable/bg_avatar_ring"
            android:contentDescription="@string/recipe_back_description"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            android:tint="@color/ds_ink_dark" />

        <TextView
            android:id="@+id/recipeDetailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_screen"
            android:alpha="0.72"
            android:text="@string/recipe_detail_title"
            android:textColor="@color/ds_ink_dark"
            style="@style/Text.Barista.Label" />

        <TextView
            android:id="@+id/recipeDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textColor="@color/ds_ink_dark"
            style="@style/Text.Barista.Display" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/recipeDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/sheet_overlap"
        android:layout_weight="1"
        android:background="@drawable/bg_sheet_top"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/recipeDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/header_padding">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Barista.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="@dimen/profile_divider">

                <LinearLayout
                    android:id="@+id/recipeDetailInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_screen"
                    android:paddingEnd="@dimen/spacing_screen">

                    <TextView
                        android:id="@+id/recipeDetailWater"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/spacing_card"
                        android:paddingBottom="@dimen/spacing_card"
                        style="@style/Text.Barista.Row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_divider"
                        android:background="?attr/colorOutline" />

                    <TextView
                        android:id="@+id/recipeDetailCoffee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/spacing_card"
                        android:paddingBottom="@dimen/spacing_card"
                        style="@style/Text.Barista.Row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_divider"
                        android:background="?attr/colorOutline" />

                    <TextView
                        android:id="@+id/recipeDetailIntensity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/spacing_card"
                        android:paddingBottom="@dimen/spacing_card"
                        style="@style/Text.Barista.Row" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/profile_divider"
                        android:background="?attr/colorOutline" />

                    <TextView
                        android:id="@+id/recipeDetailGrind"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/spacing_card"
                        android:paddingBottom="@dimen/spacing_card"
                        style="@style/Text.Barista.Row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/recipeDetailNoteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_spacing"
                android:text="@string/recipe_note_label"
                style="@style/Text.Barista.Label" />

            <EditText
                android:id="@+id/recipeDetailNoteInput"
                style="@style/Widget.Barista.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:gravity="top|start"
                android:hint="@string/recipe_note_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

            <Button
                android:id="@+id/recipeDetailSaveButton"
                style="@style/Widget.Barista.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_screen"
                android:text="@string/recipe_save_note" />

            <Button
                android:id="@+id/recipeDetailFavoriteButton"
                style="@style/Widget.Barista.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card" />

            <Button
                android:id="@+id/recipeDetailPublishButton"
                style="@style/Widget.Barista.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card" />

            <Button
                android:id="@+id/recipeDetailWhatsappButton"
                style="@style/Widget.Barista.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_card"
                android:text="@string/recipe_whatsapp" />

            <Button
                android:id="@+id/recipeDetailDeleteButton"
                style="@style/Widget.Barista.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/login_spacing"
                android:text="@string/recipe_delete_button" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
