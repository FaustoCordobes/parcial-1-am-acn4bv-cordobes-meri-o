<?xml version="1.0" encoding="utf-8"?>
<com.example.barista_app.components.TimerComponent xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_screen"
    android:layout_marginTop="@dimen/spacing_screen"
    android:layout_marginEnd="@dimen/spacing_screen"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="@dimen/profile_divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_screen">

        <TextView
            android:id="@+id/tv_timer_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_card"
            android:text="@string/toca_el_tiempo_para_cambiarlo"
            style="@style/Text.Barista.Caption"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_stopwatch"
                style="@style/Widget.Barista.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/choice_gap"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cron_metro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_timer"
                style="@style/Widget.Barista.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/choice_gap"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/cuenta_regresiva" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_timer_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/login_spacing"
            android:layout_marginBottom="@dimen/login_spacing"
            android:gravity="center"
            android:text="@string/_00_00"
            style="@style/Text.Barista.Timer"
            android:textSize="56sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_timer"
                style="@style/Widget.Barista.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/choice_gap"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/iniciar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset_timer"
                style="@style/Widget.Barista.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/choice_gap"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/reiniciar" />
        </LinearLayout>

    </LinearLayout>
</com.example.barista_app.components.TimerComponent>
