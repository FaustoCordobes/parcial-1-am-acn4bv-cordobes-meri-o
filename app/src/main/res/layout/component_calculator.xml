<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Barista.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_screen"
    android:layout_marginTop="@dimen/spacing_screen"
    android:layout_marginEnd="@dimen/spacing_screen"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="@dimen/profile_divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_screen">

        <TextView
            android:id="@+id/tv_calc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calculadora_de_proporci_n"
            style="@style/Text.Barista.Title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_screen"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_calc_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_card"
                android:paddingVertical="@dimen/spacing_screen">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agua"
                    style="@style/Text.Barista.Caption" />

                <EditText
                    android:id="@+id/et_water"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center"
                    android:hint="0"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:text="@string/_350"
                    android:fontFamily="@font/bricolage_grotesque_bold"
                    android:textAppearance="@style/Text.Barista.Timer"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ml"
                    style="@style/Text.Barista.Caption" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_card"
                android:text="@string/icon_arrows"
                style="@style/Text.Barista.Title"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_calc_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_card"
                android:paddingVertical="@dimen/spacing_screen">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/caf"
                    style="@style/Text.Barista.Caption" />

                <EditText
                    android:id="@+id/et_coffee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="center"
                    android:hint="0"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:text=""
                    android:fontFamily="@font/bricolage_grotesque_bold"
                    android:textAppearance="@style/Text.Barista.Timer"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/g"
                    style="@style/Text.Barista.Caption" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
