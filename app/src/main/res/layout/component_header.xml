<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ds_header_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/header_padding"
    android:paddingTop="@dimen/spacing_card"
    android:paddingEnd="@dimen/header_padding"
    android:paddingBottom="@dimen/header_padding_bottom">

    <ImageView
        android:layout_width="@dimen/header_logo_size"
        android:layout_height="@dimen/header_logo_size"
        android:contentDescription="@null"
        android:src="@drawable/ic_logo_bean"
        android:tint="@color/ds_header_highlight" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_gap"
        android:layout_weight="1"
        android:text="@string/header_logo_text"
        style="@style/Text.Barista.Title"
        android:textColor="@color/ds_ink_dark" />

    <TextView
        android:id="@+id/main_header_avatar"
        android:layout_width="@dimen/header_avatar_size"
        android:layout_height="@dimen/header_avatar_size"
        android:background="@drawable/bg_avatar_ring"
        android:clickable="true"
        android:contentDescription="@string/header_avatar_description"
        android:focusable="true"
        android:gravity="center"
        style="@style/Text.Barista.Label"
        android:textColor="@color/ds_ink_dark" />
</LinearLayout>
