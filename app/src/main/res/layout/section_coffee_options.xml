<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/nav_bar_space">

        <LinearLayout
            android:id="@+id/methodCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_card"
                android:text="@string/home_subtitle"
                style="@style/Text.Barista.Subtitle" />

            <TextView
                android:id="@+id/methodsLoadingTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_screen"
                android:text="@string/methods_loading"
                style="@style/Text.Barista.Subtitle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_card"
            android:layout_marginBottom="@dimen/spacing_card"
            android:text="@string/home_activity_title"
            style="@style/Text.Barista.Label" />

        <include layout="@layout/component_stats_strip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent_title"
                style="@style/Text.Barista.Label" />

            <TextView
                android:id="@+id/home_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/home_see_all"
                style="@style/Text.Barista.Link" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_recent_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_card"
            android:text="@string/no_recipes_saved"
            style="@style/Text.Barista.Subtitle"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.example.barista_app.components.ButtonCalcTimer
            android:id="@+id/btn_open_timer_calc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_spacing" />
    </LinearLayout>

</ScrollView>
