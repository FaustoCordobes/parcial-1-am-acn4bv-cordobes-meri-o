<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Barista.Card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/method_card_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="H,1:1.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_method_scrim"
            app:layout_constraintBottom_toBottomOf="@+id/method_card_image"
            app:layout_constraintEnd_toEndOf="@+id/method_card_image"
            app:layout_constraintStart_toStartOf="@+id/method_card_image"
            app:layout_constraintTop_toTopOf="@+id/method_card_image" />

        <TextView
            android:id="@+id/method_card_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/method_card_text_margin"
            android:layout_marginEnd="@dimen/method_card_text_margin"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/Text.Barista.OnPhoto"
            app:layout_constraintBottom_toTopOf="@+id/method_card_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/method_card_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/method_card_text_margin"
            android:layout_marginEnd="@dimen/method_card_text_margin"
            android:layout_marginBottom="@dimen/method_card_text_margin"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/Text.Barista.OnPhotoCaption"
            app:layout_constraintBottom_toBottomOf="@+id/method_card_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
