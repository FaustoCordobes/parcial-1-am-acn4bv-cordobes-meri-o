<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_label_2"
        style="@style/Text.Barista.Label" />

    <TextView
        android:id="@+id/step2TitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        style="@style/Text.Barista.Title" />

    <TextView
        android:id="@+id/step2DetailLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_screen"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/btn_view_detail"
        style="@style/Text.Barista.Link" />

    <EditText
        android:id="@+id/coffeeAmountInput"
        style="@style/Widget.Barista.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_screen"
        android:hint="@string/hint_coffee_amount"
        android:inputType="number" />

    <TextView
        android:id="@+id/intensityLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step2_intensity_label"
        style="@style/Text.Barista.Label" />

    <RadioGroup
        android:id="@+id/intensityRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_card"
        android:layout_marginBottom="@dimen/login_spacing"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/intensitySoftRadioButton"
            style="@style/Widget.Barista.Choice"
            android:layout_width="0dp"
            android:layout_height="@dimen/choice_height"
            android:layout_marginEnd="@dimen/choice_gap"
            android:layout_weight="1"
            android:text="@string/intensity_soft" />

        <RadioButton
            android:id="@+id/intensityMediumRadioButton"
            style="@style/Widget.Barista.Choice"
            android:layout_width="0dp"
            android:layout_height="@dimen/choice_height"
            android:layout_marginEnd="@dimen/choice_gap"
            android:layout_weight="1"
            android:checked="true"
            android:text="@string/intensity_medium" />

        <RadioButton
            android:id="@+id/intensityStrongRadioButton"
            style="@style/Widget.Barista.Choice"
            android:layout_width="0dp"
            android:layout_height="@dimen/choice_height"
            android:layout_weight="1"
            android:text="@string/intensity_strong" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/step2BackButton"
            style="@style/Widget.Barista.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_back" />

        <Button
            android:id="@+id/step2ContinueButton"
            style="@style/Widget.Barista.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_card"
            android:layout_weight="1"
            android:text="@string/btn_continue" />
    </LinearLayout>
</LinearLayout>
