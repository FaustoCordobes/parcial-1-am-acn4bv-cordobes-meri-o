<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BaristaApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/secondary_color</item>
        <item name="colorOnPrimary">@color/primary_color</item>
        <item name="colorPrimaryContainer">@color/surface_variant_dark</item>
        <item name="colorOnPrimaryContainer">@color/secondary_color</item>

        <item name="colorSecondary">@color/accent_caramel</item>
        <item name="colorOnSecondary">@color/primary_color</item>
        <item name="colorSecondaryContainer">@color/accent_caramel_dark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/secondary_color</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/secondary_color</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorSurfaceContainer">@color/surface_dark</item>
        <item name="colorSurfaceContainerLow">@color/background_dark</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant_dark</item>
        <item name="colorOutline">@color/outline_dark</item>
        <item name="colorOutlineVariant">@color/outline_dark</item>

        <item name="colorError">@color/error_dark</item>
        <item name="colorOnError">@color/primary_color</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="shapeAppearanceSmallComponent">@style/Shape.Barista.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Barista.Medium</item>
        <item name="materialButtonStyle">@style/Widget.Barista.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Barista.Card</item>
        <item name="textInputStyle">@style/Widget.Barista.TextInput</item>
    </style>
</resources>