<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BaristaApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ds_accent_dark</item>
        <item name="colorOnPrimary">@color/ds_on_accent_dark</item>
        <item name="colorPrimaryContainer">@color/ds_accent_soft_dark</item>
        <item name="colorOnPrimaryContainer">@color/ds_accent_dark</item>

        <item name="colorSecondary">@color/ds_accent_dark</item>
        <item name="colorOnSecondary">@color/ds_on_accent_dark</item>
        <item name="colorSecondaryContainer">@color/ds_accent_soft_dark</item>
        <item name="colorOnSecondaryContainer">@color/ds_ink_dark</item>

        <item name="android:colorBackground">@color/ds_background_dark</item>
        <item name="colorOnBackground">@color/ds_ink_dark</item>
        <item name="colorSurface">@color/ds_surface_dark</item>
        <item name="colorOnSurface">@color/ds_ink_dark</item>
        <item name="colorSurfaceVariant">@color/ds_background_dark</item>
        <item name="colorOnSurfaceVariant">@color/ds_ink_secondary_dark</item>
        <item name="colorSurfaceContainer">@color/ds_surface_dark</item>
        <item name="colorSurfaceContainerLow">@color/ds_background_dark</item>
        <item name="colorSurfaceContainerHigh">@color/ds_surface_dark</item>
        <item name="colorOutline">@color/ds_line_dark</item>
        <item name="colorOutlineVariant">@color/ds_line_dark</item>

        <item name="colorError">@color/ds_error_dark</item>
        <item name="colorOnError">@color/ds_on_accent_dark</item>

        <item name="android:statusBarColor">@color/ds_header_dark</item>
        <item name="android:navigationBarColor">@color/ds_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="shapeAppearanceSmallComponent">@style/Shape.Barista.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Barista.Medium</item>
        <item name="materialButtonStyle">@style/Widget.Barista.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Barista.Card</item>
        <item name="textInputStyle">@style/Widget.Barista.TextInput</item>
